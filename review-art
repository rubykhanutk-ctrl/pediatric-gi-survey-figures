# ============================================================
# 2. MOCI + GAP MATRIX REPORT
# ============================================================
print("="*68)
print("Multi-Omics Coverage Index (MOCI)")
print("="*68)
for sp in species_order:
    present = sum(len(df[(df.Species==sp) & (df.Layer==L)]) > 0 for L in layer_order)
    print(f"{sp:16s}  MOCI = {present/3:.2f}  ({present}/3 layers)")

print("\n" + "="*68)
print("Gap matrix")
print("="*68)
for sp in species_order:
    for L in layer_order:
        sub = df[(df.Species==sp) & (df.Layer==L)]
        if len(sub)==0:
            print(f"  {sp:16s} | {L:14s} | 0 records (ABSENT)")
        else:
            mm = int(sub.Months.max())
            seasonal = "seasonal" if mm>=6 else "single-season"
            sal = "salinity-controlled" if sub.SalinityControl.any() else "no salinity control"
            print(f"  {sp:16s} | {L:14s} | {len(sub)} rec | {mm:2d} mo | {seasonal:14s} | {sal}")

# ============================================================
# FIGURE 1 — Triple-panel evidence map
# ============================================================
counts = df.groupby(["Species","Layer"]).size().unstack(fill_value=0)\
           .reindex(index=species_order, columns=layer_order, fill_value=0)
months = df.groupby(["Species","Layer"])["Months"].max().unstack(fill_value=0)\
           .reindex(index=species_order, columns=layer_order, fill_value=0)
sal = (df.groupby(["Species","Layer"])["SalinityControl"]
         .apply(lambda s: int(s.any())).unstack(fill_value=0)
         .reindex(index=species_order, columns=layer_order, fill_value=0))

fig, axes = plt.subplots(1, 3, figsize=(15, 4.2))
