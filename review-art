# ============================================================
# FIGURE 5 — Keyword co-occurrence network
# ============================================================
corpus = df.Finding.fillna("").tolist()
vec = TfidfVectorizer(stop_words="english", max_features=200,
                      ngram_range=(1,2), min_df=1)
tfidf = vec.fit_transform(corpus)
terms = vec.get_feature_names_out()
co = (tfidf.T @ tfidf).toarray()
np.fill_diagonal(co, 0)
co_norm = co / co.max()

thr = 0.10
G = nx.Graph()
for i,t in enumerate(terms):
    G.add_node(t, freq=int(tfidf[:,i].sum() > 0))
for i in range(len(terms)):
    for j in range(i+1, len(terms)):
        if co_norm[i,j] > thr:
            G.add_edge(terms[i], terms[j], weight=float(co_norm[i,j]))

if G.number_of_edges() > 0:
    if HAVE_LOUVAIN:
        partition = community_louvain.best_partition(G)
    else:
        from networkx.algorithms.community import greedy_modularity_communities
        partition = {}
        for cid, comm in enumerate(greedy_modularity_communities(G)):
            for n in comm: partition[n] = cid
    cmap = plt.get_cmap("tab10")
    node_colors = [cmap(partition[n] % 10) for n in G.nodes()]
else:
    node_colors = ["grey"] * G.number_of_nodes()

pos = nx.spring_layout(G, k=0.8, seed=42, weight="weight")
fig, ax = plt.subplots(figsize=(12,9))
sizes  = [G.nodes[n]["freq"]*300 + 100 for n in G.nodes()]
widths = [G[u][v]["weight"]*4 for u,v in G.edges()]
nx.draw_networkx_edges(G, pos, width=widths, alpha=0.35, ax=ax)
nx.draw_networkx_nodes(G, pos, node_size=sizes, node_color=node_colors,
                       alpha=0.85, edgecolors="black", linewidths=0.6, ax=ax)
nx.draw_networkx_labels(G, pos, font_size=8, ax=ax)
ax.set_title("Keyword co-occurrence network (exploratory; n = 9 records)", fontweight="bold")
ax.axis("off")
plt.tight_layout()
plt.savefig("figures/fig5_keyword_network.pdf", bbox_inches="tight")
plt.savefig("figures/fig5_keyword_network.png", dpi=300, bbox_inches="tight")
plt.close()
print("Figure 5 saved.")
print("\nAll figures generated in ./figures/")
