    (counts, "Records per species × layer",      "Reds",   "Count"),
    (months, "Max seasonal resolution (months)", "Blues",  "Months"),
    (sal,    "Salinity controlled (1 = yes)",    "Greens", "Binary"),
]
for ax, (mat, title, cmap, cbl) in zip(axes, panels):
