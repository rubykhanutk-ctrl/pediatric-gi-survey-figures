# FIGURE 5 — "TERM CLUSTER MAP": co-occurrence heatmap + dendrograms
# ============================================================
def figure5():
    """
    Clustered co-occurrence heatmap of the top 30 terms, with row and column
    dendrograms. This is the standard bibliometric visual in Nature Reviews
    (not a force-directed network). Cell values = number of records in which
    the row and column terms co-occur.
    """
    from sklearn.feature_extraction.text import CountVectorizer

    findings = [
        "April phenolic maximum chlorogenic acid",
        "Temperature correlates cryptochlorogenic acid Feb-Apr minimum",
        "Limonene EO sabinene",
        "Phenolics hypoglycaemic",
        "Culturable endophytic strains",
        "Metabolites differential organ-specific salinity",
        "Proteins identified energy ion homeostasis",
        "Proteins identified carbon nitrogen coordination",
        "OTUs compartments rhizosphere endosphere",
    ]
    vec = CountVectorizer(stop_words="english", max_features=40,
                          ngram_range=(1, 1), min_df=1)
    X = vec.fit_transform(findings).toarray()
    terms = vec.get_feature_names_out()
    co = X.T @ X
    np.fill_diagonal(co, 0)

    # Keep top 30 by total co-occurrence
    order = np.argsort(co.sum(axis=0))[::-1][:30]
    terms = terms[order]
    co = co[np.ix_(order, order)]

    # Hierarchical clustering
    row_link = linkage(co, method="average")
    col_link = linkage(co.T, method="average")
    row_order = leaves_list(row_link)
    col_order = leaves_list(col_link)
    co_ord = co[np.ix_(row_order, col_order)]
    terms_ord_row = terms[row_order]

    # Color map: white to deep red
    cmap = LinearSegmentedColormap.from_list("cooc",
        ["#FFFFFF", "#FDDBC7", "#EF8A62", "#B2182B", "#67001F"])

    fig = plt.figure(figsize=(11, 9.5), constrained_layout=True)
    gs = gridspec.GridSpec(2, 2, figure=fig,
                           width_ratios=[0.18, 1], height_ratios=[0.18, 1],
                           wspace=0.02, hspace=0.02)

    # Row dendrogram
    ax_r = fig.add_subplot(gs[1, 0])
    dendrogram(row_link, orientation="left", ax=ax_r, no_labels=True,
               color_threshold=0)
    ax_r.axis("off")

    # Col dendrogram
    ax_c = fig.add_subplot(gs[0, 1])
    dendrogram(col_link, orientation="top", ax=ax_c, no_labels=True,
               color_threshold=0)
    ax_c.axis("off")

    # Heatmap
    ax_h = fig.add_subplot(gs[1, 1])
    im = ax_h.imshow(co_ord, cmap=cmap, aspect="auto")
    ax_h.set_xticks(range(len(terms_ord_row)))
    ax_h.set_xticklabels(terms_ord_row, rotation=45, ha="right", fontsize=8)
    ax_h.set_yticks(range(len(terms_ord_row)))
    ax_h.set_yticklabels(terms_ord_row, fontsize=8)
    ax_h.tick_params(axis="both", length=0)

    # Annotate non-zero cells
    for i in range(co_ord.shape[0]):
        for j in range(co_ord.shape[1]):
            v = co_ord[i, j]
            if v > 0:
                color = "white" if v > co_ord.max() * 0.55 else "black"
                ax_h.text(j, i, int(v), ha="center", va="center",
                          fontsize=7, fontweight="bold", color=color)

    cb = fig.colorbar(im, ax=ax_h, fraction=0.03, pad=0.02)
    cb.set_label("Co-occurrence count (records)", fontsize=8.5)
    cb.ax.tick_params(labelsize=7.5)

    fig.suptitle("Term co-occurrence matrix (n = 9 records, top 30 terms)",
                 fontsize=12, fontweight="bold", y=1.00)

    plt.savefig("figures/fig5_term_cluster_map.pdf")
    plt.savefig("figures/fig5_term_cluster_map.png", dpi=600)
    plt.close()
    print("Fig 5 saved")


